# Operation Crucible
# Kali Linux unattended installation

# ------------------------------------------------------------
# Locale / keyboard
# ------------------------------------------------------------

d-i debian-installer/language string en
d-i debian-installer/country string {{ country }}
d-i debian-installer/locale string {{ locale }}

d-i localechooser/shortlist select {{ country }}
d-i localechooser/preferred-locale select {{ locale }}
d-i localechooser/languagelist select en

d-i keyboard-configuration/xkb-keymap select {{ keyboard_layout }}
d-i console-keymaps-at/keymap select {{ keyboard_layout }}

# ------------------------------------------------------------
# Networking
#
# Persistent internal topology NICs occupy the lowest
# VirtualBox slots.
#
# Crucible's temporary NAT interface is appended after
# those NICs and selected dynamically.
#
# The Crucible management interface is appended after
# the NAT interface and configured during the late command.
# ------------------------------------------------------------

d-i netcfg/choose_interface select {{ internet_interface }}

d-i netcfg/get_hostname string {{ hostname }}
d-i netcfg/get_domain string unassigned-domain

d-i netcfg/wireless_wep string

# ------------------------------------------------------------
# Kali installation package source
#
# Operation Crucible deliberately performs the tasksel/package
# installation from the Kali installer ISO rather than mixing
# the ISO snapshot with the live kali-rolling repository.
#
# Kali Rolling changes continuously. Mixing an older installer
# snapshot with current repository packages during tasksel can
# produce unsatisfiable dependency transitions.
#
# The live kali-rolling repository is installed by the
# preseed late command after tasksel has completed.
# Crucible's first-boot bootstrap then performs apt-get update
# and dist-upgrade so that the complete installed system moves
# to the current rolling state together.
# ------------------------------------------------------------

d-i apt-setup/use_mirror boolean false

d-i apt-setup/non-free boolean true
d-i apt-setup/contrib boolean true
d-i apt-setup/non-free-firmware boolean true

# Keep the installer ISO available while tasksel installs the
# default Kali package set.
d-i apt-setup/disable-cdrom-entries boolean false

d-i apt-setup/enable-source-repositories boolean false

# ------------------------------------------------------------
# Identity
# ------------------------------------------------------------

d-i passwd/root-login boolean false

d-i passwd/user-fullname string {{ realname }}
d-i passwd/username string {{ username }}

d-i passwd/user-password-crypted password {{ password_hash }}

d-i passwd/user-default-groups string audio cdrom video sudo netdev plugdev users

# ------------------------------------------------------------
# Clock
# ------------------------------------------------------------

d-i clock-setup/utc boolean true
d-i time/zone string {{ timezone }}
d-i clock-setup/ntp boolean false

# ------------------------------------------------------------
# Storage
#
# Crucible VMs use a dedicated disposable virtual disk.
# ------------------------------------------------------------

d-i partman-auto/disk string /dev/sda
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic

d-i partman-partitioning/confirm_write_new_label boolean true

d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

d-i partman-md/confirm boolean true

# ------------------------------------------------------------
# Kali package selection
# ------------------------------------------------------------

tasksel tasksel/first multiselect standard,core,desktop-xfce,meta-default

d-i pkgsel/include string openssh-server python3 python3-apt sudo ca-certificates network-manager

d-i pkgsel/update-policy select none
d-i pkgsel/upgrade select none

popularity-contest popularity-contest/participate boolean false

# Avoid interactive package configuration questions.

samba-common samba-common/dhcp boolean false

macchanger macchanger/automatically_run boolean false

kismet-capture-common kismet-capture-common/install-users string
kismet-capture-common kismet-capture-common/install-setuid boolean true

wireshark-common wireshark-common/install-setuid boolean true

sslh sslh/inetd_or_standalone select standalone

atftpd atftpd/use_inetd boolean false

# ------------------------------------------------------------
# Bootloader
# ------------------------------------------------------------

d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean false
d-i grub-installer/bootdev string /dev/sda

# ------------------------------------------------------------
# Crucible bootstrap
#
# This installs/configures SSH + Python, configures the
# Crucible management interface,
# and creates /var/lib/crucible/bootstrap-complete.
# ------------------------------------------------------------

d-i preseed/late_command string {{ late_command }}

# ------------------------------------------------------------
# Finish
# ------------------------------------------------------------

d-i finish-install/reboot_in_progress note