#cloud-config
autoinstall:
  version: 1
{% if source_id %}
  source:
    id: {{ source_id | yaml_string }}
{% endif %}
  refresh-installer:
    update: false

  locale: {{ locale | yaml_string }}

  keyboard:
    layout: {{ keyboard_layout | yaml_string }}
    variant: {{ keyboard_variant | yaml_string }}

  network:
    version: 2

    ethernets:

      crucible-nat:
        match:
          macaddress: {{ internet_mac_address | yaml_string }}
        dhcp4: true
        dhcp6: false
        dhcp4-overrides:
          route-metric: {{ internet_route_metric }}
        optional: true

      crucible-management:
        match:
          macaddress: {{ management_mac_address | yaml_string }}
        dhcp4: false
        dhcp6: false
        addresses:
          - {{ management_address | yaml_string }}
        optional: true

{% for interface in topology_interfaces %}
      topology-{{ interface.slot }}:
        match:
          macaddress: {{ interface.mac_address | yaml_string }}

{% if interface.ipv4.method == "dhcp" %}
        dhcp4: true
        dhcp6: false
        dhcp4-overrides:
          route-metric: {{ topology_route_metric }}
        optional: true

{% elif interface.ipv4.method == "static" %}
        dhcp4: false
        dhcp6: false
        addresses:
          - {{ interface.ipv4.address | yaml_string }}
{% if interface.ipv4.gateway %}
        routes:
          - to: default
            via: {{ interface.ipv4.gateway | yaml_string }}
            metric: {{ topology_route_metric }}
{% endif %}
        optional: true

{% endif %}
{% endfor %}
        
  timezone: {{ timezone | yaml_string }}

  identity:
    hostname: {{ hostname | yaml_string }}
    realname: {{ realname | yaml_string }}
    username: {{ username | yaml_string }}
    password: {{ password_hash | yaml_string }}

  ssh:
    install-server: {{ "true" if ssh_install_server else "false" }}
    allow-pw: {{ "true" if ssh_allow_password else "false" }}
{% if ssh_authorized_keys %}
    authorized-keys:
{% for key in ssh_authorized_keys %}
      - {{ key | yaml_string }}
{% endfor %}
{% else %}
    authorized-keys: []
{% endif %}

  storage:
    layout:
      name: {{ storage_layout | yaml_string }}

  updates: {{ updates | yaml_string }}
  shutdown: {{ shutdown | yaml_string }}

  late-commands:
{% for command in late_commands %}
    - {{ command | yaml_string }}
{% endfor %}

  reporting:
    builtin:
      type: print
