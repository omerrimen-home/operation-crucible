# Managed by Operation Crucible
#
# CIS Ubuntu Linux 26.04 audit rule set.
#
# Intentionally does NOT set:
#
#   -e 2
#
# Crucible must remain capable of subsequent
# configuration runs.

{% set controls = crucible_cis_execution_controls %}

{% for arch in crucible_cis_audit_arches %}

{% if '6.2.3.1' in controls %}
-a always,exit -F arch={{ arch }} -F path=/etc/sudoers -F perm=wa -k scope
-a always,exit -F arch={{ arch }} -F dir=/etc/sudoers.d -F perm=wa -k scope
{% endif %}

{% if '6.2.3.2' in controls %}
-a always,exit -F arch={{ arch }} -S execve -C euid!=uid -F auid!=unset -k user_emulation
{% endif %}

{% if '6.2.3.3' in controls and '/var/log/sudo.log' in crucible_cis_audit_existing_paths %}
-a always,exit -F arch={{ arch }} -F path=/var/log/sudo.log -F perm=wa -F auid>={{ crucible_cis_uid_min }} -F auid!=unset -k sudo_log_file
{% endif %}

{% if '6.2.3.4' in controls %}
-a always,exit -F arch={{ arch }} -S adjtimex,settimeofday,clock_settime -k time-change
{% endif %}

{% if '6.2.3.5' in controls %}
-a always,exit -F arch={{ arch }} -S sethostname,setdomainname -k system-locale
{% endif %}

{% if '6.2.3.6' in controls %}
-a always,exit -F arch={{ arch }} -F path=/etc/issue -F perm=wa -k system-locale
-a always,exit -F arch={{ arch }} -F path=/etc/issue.net -F perm=wa -k system-locale
{% endif %}

{% if '6.2.3.7' in controls %}
-a always,exit -F arch={{ arch }} -F path=/etc/hosts -F perm=wa -k system-locale
-a always,exit -F arch={{ arch }} -F path=/etc/hostname -F perm=wa -k system-locale
{% endif %}

{% if '6.2.3.8' in controls %}
{% if '/etc/network' in crucible_cis_audit_existing_paths %}
-a always,exit -F arch={{ arch }} -F dir=/etc/network -F perm=wa -k system-locale
{% endif %}
{% if '/etc/netplan' in crucible_cis_audit_existing_paths %}
-a always,exit -F arch={{ arch }} -F dir=/etc/netplan -F perm=wa -k system-locale
{% endif %}
{% endif %}

{% if '6.2.3.9' in controls and '/etc/NetworkManager' in crucible_cis_audit_existing_paths %}
-a always,exit -F arch={{ arch }} -F dir=/etc/NetworkManager -F perm=wa -k system-locale
{% endif %}

{% if '6.2.3.11' in controls %}
-a always,exit -F arch={{ arch }} -S creat,open,openat,truncate,ftruncate -F exit=-EACCES -F auid>={{ crucible_cis_uid_min }} -F auid!=unset -k access
-a always,exit -F arch={{ arch }} -S creat,open,openat,truncate,ftruncate -F exit=-EPERM -F auid>={{ crucible_cis_uid_min }} -F auid!=unset -k access
{% endif %}

{% if '6.2.3.12' in controls %}
-a always,exit -F arch={{ arch }} -F path=/etc/group -F perm=wa -k identity
-a always,exit -F arch={{ arch }} -F path=/etc/group- -F perm=wa -k identity
{% endif %}

{% if '6.2.3.13' in controls %}
-a always,exit -F arch={{ arch }} -F path=/etc/passwd -F perm=wa -k identity
-a always,exit -F arch={{ arch }} -F path=/etc/passwd- -F perm=wa -k identity
{% endif %}

{% if '6.2.3.14' in controls %}
-a always,exit -F arch={{ arch }} -F path=/etc/shadow -F perm=wa -k identity
-a always,exit -F arch={{ arch }} -F path=/etc/gshadow -F perm=wa -k identity
{% endif %}

{% if '6.2.3.15' in controls and '/etc/security/opasswd' in crucible_cis_audit_existing_paths %}
-a always,exit -F arch={{ arch }} -F path=/etc/security/opasswd -F perm=wa -k identity
{% endif %}

{% if '6.2.3.16' in controls %}
-a always,exit -F arch={{ arch }} -F path=/etc/nsswitch.conf -F perm=wa -k identity
{% endif %}

{% if '6.2.3.17' in controls %}
{% if '/etc/pam.conf' in crucible_cis_audit_existing_paths %}
-a always,exit -F arch={{ arch }} -F path=/etc/pam.conf -F perm=wa -k identity
{% endif %}
-a always,exit -F arch={{ arch }} -F dir=/etc/pam.d -F perm=wa -k identity
{% endif %}

{% if '6.2.3.18' in controls %}
-a always,exit -F arch={{ arch }} -S chmod,fchmod,fchmodat -F auid>={{ crucible_cis_uid_min }} -F auid!=unset -k perm_mod
{% endif %}

{% if '6.2.3.19' in controls %}
-a always,exit -F arch={{ arch }} -S chown,fchown,lchown,fchownat -F auid>={{ crucible_cis_uid_min }} -F auid!=unset -k perm_mod
{% endif %}

{% if '6.2.3.20' in controls %}
-a always,exit -F arch={{ arch }} -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>={{ crucible_cis_uid_min }} -F auid!=unset -k perm_mod
{% endif %}

{% if '6.2.3.21' in controls %}
-a always,exit -F arch={{ arch }} -S mount -F auid>={{ crucible_cis_uid_min }} -F auid!=unset -k mounts
{% endif %}

{% if '6.2.3.22' in controls %}
{% if '/var/run/utmp' in crucible_cis_audit_existing_paths %}
-a always,exit -F arch={{ arch }} -F path=/var/run/utmp -F perm=wa -k session
{% endif %}
{% if '/var/log/wtmp' in crucible_cis_audit_existing_paths %}
-a always,exit -F arch={{ arch }} -F path=/var/log/wtmp -F perm=wa -k session
{% endif %}
{% if '/var/log/btmp' in crucible_cis_audit_existing_paths %}
-a always,exit -F arch={{ arch }} -F path=/var/log/btmp -F perm=wa -k session
{% endif %}
{% endif %}

{% if '6.2.3.23' in controls %}
{% if '/var/log/lastlog' in crucible_cis_audit_existing_paths %}
-a always,exit -F arch={{ arch }} -F path=/var/log/lastlog -F perm=wa -k logins
{% endif %}
{% if '/var/run/faillock' in crucible_cis_audit_existing_paths %}
-a always,exit -F arch={{ arch }} -F dir=/var/run/faillock -F perm=wa -k logins
{% endif %}
{% endif %}

{% if '6.2.3.24' in controls %}
-a always,exit -F arch={{ arch }} -S unlink,unlinkat -F auid>={{ crucible_cis_uid_min }} -F auid!=unset -k delete
{% endif %}

{% if '6.2.3.25' in controls %}
-a always,exit -F arch={{ arch }} -S rename,renameat,renameat2 -F auid>={{ crucible_cis_uid_min }} -F auid!=unset -k delete
{% endif %}

{% if '6.2.3.26' in controls %}
{% if '/etc/apparmor' in crucible_cis_audit_existing_paths %}
-a always,exit -F arch={{ arch }} -F dir=/etc/apparmor -F perm=wa -k MAC-policy
{% endif %}
-a always,exit -F arch={{ arch }} -F dir=/etc/apparmor.d -F perm=wa -k MAC-policy
{% endif %}

{% if '6.2.3.32' in controls %}
-a always,exit -F arch={{ arch }} -S init_module,finit_module -F auid>={{ crucible_cis_uid_min }} -F auid!=unset -k modules
{% endif %}

{% if '6.2.3.33' in controls %}
-a always,exit -F arch={{ arch }} -S delete_module -F auid>={{ crucible_cis_uid_min }} -F auid!=unset -k modules
{% endif %}

{% endfor %}


# ============================================================
# Privileged commands
# ============================================================

{% if '6.2.3.10' in controls %}
{% for command in crucible_cis_privileged_commands %}
{% for arch in crucible_cis_audit_arches %}
-a always,exit -F arch={{ arch }} -F path={{ command }} -F perm=x -F auid>={{ crucible_cis_uid_min }} -F auid!=unset -k privileged
{% endfor %}
{% endfor %}
{% endif %}


# ============================================================
# Named security commands
# ============================================================

{% for result in crucible_cis_audit_command_results.results | default([]) %}
{% if result.rc == 0 and result.stdout | trim %}
{% if result.item.control in controls %}
{% for arch in crucible_cis_audit_arches %}
-a always,exit -F arch={{ arch }} -F path={{ result.stdout | trim }} -F perm=x -F auid>={{ crucible_cis_uid_min }} -F auid!=unset -k {{ result.item.key }}
{% endfor %}
{% endif %}
{% endif %}
{% endfor %}