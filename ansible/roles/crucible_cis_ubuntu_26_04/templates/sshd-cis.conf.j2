# Managed by Operation Crucible
#
# CIS Ubuntu Linux 26.04 LTS - SSH baseline

Banner /etc/issue.net

Ciphers -3des-cbc,blowfish-cbc,cast128-cbc,aes128-cbc,aes192-cbc,aes256-cbc,arcfour,arcfour128,arcfour256,rijndael-cbc@lysator.liu.se

KexAlgorithms -diffie-hellman-group1-sha1,diffie-hellman-group14-sha1,diffie-hellman-group-exchange-sha1

MACs -hmac-md5,hmac-md5-96,hmac-ripemd160,hmac-sha1-96,umac-64@openssh.com,hmac-md5-etm@openssh.com,hmac-md5-96-etm@openssh.com,hmac-ripemd160-etm@openssh.com,hmac-sha1-96-etm@openssh.com,umac-64-etm@openssh.com,umac-128-etm@openssh.com

ClientAliveInterval {{ crucible_cis_ssh_client_alive_interval }}
ClientAliveCountMax {{ crucible_cis_ssh_client_alive_count_max }}

LoginGraceTime {{ crucible_cis_ssh_login_grace_time }}

LogLevel VERBOSE

GSSAPIAuthentication no
HostbasedAuthentication no
IgnoreRhosts yes

MaxAuthTries {{ crucible_cis_ssh_max_auth_tries }}
MaxSessions {{ crucible_cis_ssh_max_sessions }}
MaxStartups {{ crucible_cis_ssh_max_startups }}

PermitEmptyPasswords no
PermitRootLogin no
PermitUserEnvironment no

UsePAM yes